; TakaBooks — npm configuration
; Moshiur Rahman (@bemoshiur) · TICON SYSTEM LTD — https://ticonsys.com
;
; The @bemoshiur scope is published to and installed from GitHub Packages,
; not npmjs.com. Registry URL is exactly this — no trailing path, no /npm suffix:
;   https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-npm-registry
@bemoshiur:registry=https://npm.pkg.github.com

; Authentication is read from the NODE_AUTH_TOKEN environment variable, never
; from this file. NEVER commit a literal token here.
;
;   In GitHub Actions: actions/setup-node writes an equivalent .npmrc and the
;   publish step sets NODE_AUTH_TOKEN to secrets.GITHUB_TOKEN. Nothing to do.
;
;   Publishing by hand: GitHub Packages accepts CLASSIC personal access tokens
;   only — fine-grained PATs do not work with the npm registry. The token needs
;   the write:packages scope (read:packages to install, repo as well for a
;   private repository). Grant it with:
;
;       gh auth refresh -h github.com -s write:packages,read:packages
;       export NODE_AUTH_TOKEN="$(gh auth token)"
;       npm publish
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

; Installing @bemoshiur/takabooks requires authentication even though the
; package is public — that is how GitHub Packages works, and it is why
; `npx @bemoshiur/takabooks` returns 401 on a machine that has never
; authenticated. Consumers need this same scope line plus a read:packages
; token in their own ~/.npmrc. The dependency-free alternative is to download
; a bundle straight from https://github.com/bemoshiur/TakaBooks/releases/latest

; Housekeeping for contributors.
save-exact=true
fund=false
audit=false
