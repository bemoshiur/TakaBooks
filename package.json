    "tax-compliance",
    "sme",
    "llm-agnostic",
    "claude-skill",
    "ai-agent",
    "bangla",
    "ticon-system-ltd"
  ],
  "homepage": "https://ticonsys.com",
  "bugs": {
    "url": "https://github.com/bemoshiur/TakaBooks/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bemoshiur/TakaBooks.git"
  },
  "license": "MIT",
  "author": "Moshiur Rahman (TICON SYSTEM LTD) <https://ticonsys.com>",
  "bin": {
    "takabooks": "bin/takabooks.mjs"
  },
